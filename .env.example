# spring-order 环境变量示例
# 用法：复制为 .env 后填入真实值。.env 已被 .gitignore 忽略，不会入库；
# 本文件 .env.example 会入库作为模板。
# 所有变量均有默认值，本地零配置执行 `docker compose up -d --build` 即可运行。

# ---- Postgres / 后端数据源 ----
POSTGRES_PASSWORD=order
ORDER_DB_PASSWORD=order

# ---- Grafana 管理员凭据 ----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
